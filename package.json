{
  "name": "immich-dedupe-gui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter api test",
    "test:ui": "pnpm --filter web test:ui"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
